# ==============================================================================
# VPSMaster: Environment Configuration Template
# ==============================================================================

PROJECT_NAME="VPSMaster"
ENVIRONMENT="production"
PORT=8000
HOST="127.0.0.1"

# Database Configuration (SQLite or PostgreSQL)
DATABASE_URL="sqlite:////etc/vpsmaster/vpsmaster.db"

# JWT Authentication & Session Security
SECRET_KEY="generate-with-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Agent Internal Authentication
AGENT_URL="http://127.0.0.1:8001"
AGENT_SECRET_KEY="generate-with-openssl-rand-hex-32"

# Initial Super Admin Seed Credentials
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_EMAIL="admin@vpsmaster.local"
DEFAULT_ADMIN_PASSWORD="Admin@123456"

# Backup Storage
STORAGE_PATH="/var/backups/vpsmaster"

