# ==============================================================================
# Managed by VPSMaster: PHP-FPM Website Template for {{ DOMAIN }}
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name {{ DOMAIN }} {{ ALIASES }};

{% if FORCE_HTTPS %}
    # Force HTTP to HTTPS Redirection
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ DOMAIN }} {{ ALIASES }};

    ssl_certificate {{ SSL_CERTIFICATE }};
    ssl_certificate_key {{ SSL_KEY }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
{% endif %}

    root {{ DOCUMENT_ROOT }};
    index index.php index.html index.htm;

    access_log /var/log/nginx/{{ DOMAIN }}.access.log combined;
    error_log /var/log/nginx/{{ DOMAIN }}.error.log warn;

    client_max_body_size 256M;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Pass PHP scripts to FastCGI server
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php{{ PHP_VERSION }}-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_read_timeout 300s;
    }

    # Deny access to sensitive files and VCS repositories
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }

    location = /robots.txt {
        access_log off;
        log_not_found off;
    }

    # Static assets browser caching
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|webp|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }
}

